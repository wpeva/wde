diff --git a/third_party/icu/source/common/unicode/timezone.h b/third_party/icu/source/common/unicode/timezone.h
--- a/third_party/icu/source/common/unicode/timezone.h
+++ b/third_party/icu/source/common/unicode/timezone.h
@@ -0,0 +1,30 @@
+// Antidetect: Timezone ID spoofing
+// This patch intercepts ICU timezone detection to return a custom timezone
+
+// Applied to: third_party/icu/source/i18n/timezone.cpp
+// Function: TimeZone::detectHostTimeZone()
+//
+// The patch modifies the detectHostTimeZone() function to check for
+// the --antidetect-timezone-id command-line switch and return the specified
+// timezone ID instead of the system timezone.
+//
+// Usage:
+//   --antidetect-timezone-id=America/New_York
+//   --antidetect-timezone-id=Europe/London
+//   --antidetect-timezone-id=Asia/Tokyo
+
diff --git a/third_party/icu/source/i18n/timezone.cpp b/third_party/icu/source/i18n/timezone.cpp
--- a/third_party/icu/source/i18n/timezone.cpp
+++ b/third_party/icu/source/i18n/timezone.cpp
@@ -100,6 +100,8 @@
 #include "uassert.h"
 #include "uenumimp.h"
 #include "uhash.h"
+#include "base/command_line.h"
+#include "base/strings/string_piece.h"
 #include "umutex.h"
 #include "uresimp.h"
 #include "uvector.h"
@@ -500,6 +502,18 @@ TimeZone* U_EXPORT2
 TimeZone::detectHostTimeZone()
 {
+    // Antidetect: Override timezone ID
+    const auto* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd->HasSwitch("antidetect-timezone-id")) {
+        std::string tz_id = cmd->GetSwitchValueASCII("antidetect-timezone-id");
+        if (!tz_id.empty()) {
+            UnicodeString id = UnicodeString::fromUTF8(
+                base::StringPiece(tz_id.data(), tz_id.size()));
+            return TimeZone::createTimeZone(id);
+        }
+    }
+
     // We access system timezone data through uprv_tzset(),
     // uprv_tzname(), and uprv_timezone().
     int32_t rawOffset = 0;
