+// Antidetect: Get timezone offset override from command line
+bool GetAntidetectTimezoneOffset(int* offset_minutes) {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch("antidetect-timezone-offset"))
+    return false;
+
+  int value = 0;
+  if (base::StringToInt(
+          cmd->GetSwitchValueASCII("antidetect-timezone-offset"), &value)) {
+    *offset_minutes = value;
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
 int DateCache::DaylightSavingsOffsetInMs(int64_t time_ms) {
   ...
 }

+// Antidetect: Override local timezone offset
+int DateCache::GetLocalOffsetFromOS(int64_t time_ms, bool is_utc) {
+  int override_minutes = 0;
+  if (GetAntidetectTimezoneOffset(&override_minutes)) {
+    return override_minutes * 60 * 1000;  // Convert minutes to milliseconds
+  }
+  return GetLocalOffsetFromOSOriginal(time_ms, is_utc);
+}
