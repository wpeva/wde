+
+// Antidetect: Override getParameter for WebGL vendor/renderer spoofing
+ScriptValue WebGLRenderingContextBase::getParameterAntidetect(
+    ScriptState* script_state,
+    GLenum pname) {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+
+  if (pname == GL_RENDERER) {
+    if (cmd->HasSwitch(antidetect::kAntidetectWebglRenderer)) {
+      return WebGLAny(script_state,
+          String::FromUTF8(cmd->GetSwitchValueASCII(
+              antidetect::kAntidetectWebglRenderer)));
+    }
+  }
+
+  if (pname == GL_VENDOR) {
+    if (cmd->HasSwitch(antidetect::kAntidetectWebglVendor)) {
+      return WebGLAny(script_state,
+          String::FromUTF8(cmd->GetSwitchValueASCII(
+              antidetect::kAntidetectWebglVendor)));
+    }
+  }
+
+  return getParameter(script_state, pname);
+}

