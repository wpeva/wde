+// Antidetect: WebRTC IP leak prevention policy
+// Policies:
+//   "disable"          - completely disable WebRTC
+//   "disable_non_proxied_udp" - disable non-proxied UDP (most common)
+//   "default_public_interface_only" - only expose default public interface
+//   "default_public_and_private_interfaces" - expose default interfaces
+webrtc::PeerConnectionInterface::IceTransportsType
+GetAntidetectWebRtcPolicy() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch(antidetect::kAntidetectWebrtcPolicy))
+    return webrtc::PeerConnectionInterface::kAll;
+
+  std::string policy = cmd->GetSwitchValueASCII(
+      antidetect::kAntidetectWebrtcPolicy);
+
+  if (policy == "disable" || policy == "disable_non_proxied_udp")
+    return webrtc::PeerConnectionInterface::kRelay;
+
+  if (policy == "default_public_interface_only")
+    return webrtc::PeerConnectionInterface::kNoHost;
+
+  return webrtc::PeerConnectionInterface::kAll;
+}
