+// Antidetect: Add noise to getChannelData output
+void AudioBuffer::ApplyAudioNoise(float* data, size_t length) {
+  if (!antidetect::IsAudioNoiseEnabled())
+    return;
+
+  uint64_t seed = antidetect::GetAudioNoiseSeed();
+  uint64_t state = seed;
+  if (state == 0) state = 0xcafebeef12345678ULL;
+
+  for (size_t i = 0; i < length; ++i) {
+    state ^= state >> 12;
+    state ^= state << 25;
+    state ^= state >> 27;
+    uint64_t rng = state * 0x2545F4914F6CDD1DULL;
+
+    // Add noise of magnitude ~1e-7 (imperceptible but changes hash)
+    if ((rng & 0x7) == 0) {
+      double noise = (static_cast<double>(rng >> 32) / 0xFFFFFFFF - 0.5) * 2e-7;
+      data[i] += static_cast<float>(noise);
+    }
+  }
+}
+
 NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
     unsigned channel_index,
     ExceptionState& exception_state) {
@@ -209,6 +234,10 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
   }
   DOMFloat32Array* channel_data = channels_[channel_index].Get();

+  // Antidetect: Apply noise before returning channel data
+  ApplyAudioNoise(static_cast<float*>(channel_data->Data()),
+                  channel_data->length());
+
   return NotShared<DOMFloat32Array>(channel_data);
 }

