 const Vector<String>& NavigatorLanguage::languages() {
+  // Antidetect: Override languages from command line
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(antidetect::kAntidetectLanguages)) {
+    if (languages_dirty_ || languages_.empty()) {
+      languages_.clear();
+      std::string langs_str = cmd->GetSwitchValueASCII(
+          antidetect::kAntidetectLanguages);
+      std::vector<std::string> parts = base::SplitString(
+          langs_str, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+      for (const auto& p : parts)
+        languages_.push_back(String::FromUTF8(p));
+      languages_dirty_ = false;
+    }
+    return languages_;
+  }
+
   if (languages_dirty_) {
     languages_ = {};
     languages_.ReserveInitialCapacity(UserPreferredLanguages().size());
