@@ -0,0 +1,128 @@
+// Copyright 2024 AntiBrowser Authors. All rights reserved.
+// Antidetect utilities for browser fingerprint masking
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_ANTIDETECT_ANTIDETECT_UTILS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_ANTIDETECT_ANTIDETECT_UTILS_H_
+
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace antidetect {
+
+// Command-line switches for antidetect features
+constexpr char kAntidetectCanvasNoise[] = "antidetect-canvas-noise";
+constexpr char kAntidetectCanvasNoiseSeed[] = "antidetect-canvas-noise-seed";
+constexpr char kAntidetectWebglVendor[] = "antidetect-webgl-vendor";
+constexpr char kAntidetectWebglRenderer[] = "antidetect-webgl-renderer";
+constexpr char kAntidetectWebglNoiseEnabled[] = "antidetect-webgl-noise";
+constexpr char kAntidetectAudioNoise[] = "antidetect-audio-noise";
+constexpr char kAntidetectAudioNoiseSeed[] = "antidetect-audio-noise-seed";
+constexpr char kAntidetectClientRectsNoise[] = "antidetect-client-rects-noise";
+constexpr char kAntidetectClientRectsNoiseSeed[] = "antidetect-client-rects-noise-seed";
+constexpr char kAntidetectUserAgent[] = "antidetect-user-agent";
+constexpr char kAntidetectPlatform[] = "antidetect-platform";
+constexpr char kAntidetectHardwareConcurrency[] = "antidetect-hardware-concurrency";
+constexpr char kAntidetectDeviceMemory[] = "antidetect-device-memory";
+constexpr char kAntidetectLanguages[] = "antidetect-languages";
+constexpr char kAntidetectScreenWidth[] = "antidetect-screen-width";
+constexpr char kAntidetectScreenHeight[] = "antidetect-screen-height";
+constexpr char kAntidetectScreenColorDepth[] = "antidetect-screen-color-depth";
+constexpr char kAntidetectPixelRatio[] = "antidetect-pixel-ratio";
+constexpr char kAntidetectTimezoneOffset[] = "antidetect-timezone-offset";
+constexpr char kAntidetectTimezoneId[] = "antidetect-timezone-id";
+constexpr char kAntidetectWebrtcPolicy[] = "antidetect-webrtc-policy";
+constexpr char kAntidetectFontList[] = "antidetect-font-list";
+constexpr char kAntidetectPluginList[] = "antidetect-plugin-list";
+constexpr char kAntidetectDoNotTrack[] = "antidetect-do-not-track";
+constexpr char kAntidetectNoWebdriver[] = "antidetect-no-webdriver";
+
+// ---- Canvas noise ----
+
+inline bool IsCanvasNoiseEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kAntidetectCanvasNoise);
+}
+
+inline uint64_t GetCanvasNoiseSeed() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(kAntidetectCanvasNoiseSeed)) {
+    uint64_t seed = 0;
+    if (base::StringToUint64(
+            cmd->GetSwitchValueASCII(kAntidetectCanvasNoiseSeed), &seed)) {
+      return seed;
+    }
+  }
+  // Generate a random seed per session if not provided
+  static uint64_t session_seed = base::RandUint64();
+  return session_seed;
+}
+
+// Applies deterministic per-pixel noise to RGBA image data.
+// The noise is subtle (LSB modification) to avoid visual artifacts
+// but changes the canvas hash.
+inline void AddCanvasNoise(uint8_t* data, size_t length, uint64_t seed) {
+  if (!data || length == 0)
+    return;
+
+  // Simple xorshift64* PRNG seeded per profile
+  uint64_t state = seed;
+  if (state == 0) state = 0xdeadbeefcafe1234ULL;
+
+  for (size_t i = 0; i < length; i += 4) {
+    // xorshift64*
+    state ^= state >> 12;
+    state ^= state << 25;
+    state ^= state >> 27;
+    uint64_t rng = state * 0x2545F4914F6CDD1DULL;
+
+    // Only modify ~10% of pixels to minimize visual impact
+    if ((rng & 0xF) < 2) {
+      // Flip the least significant bit of R, G, or B (not alpha)
+      uint8_t channel = (rng >> 4) % 3;  // 0=R, 1=G, 2=B
+      if (i + channel < length) {
+        data[i + channel] ^= 1;
+      }
+    }
+  }
+}
+
+// ---- Audio noise ----
+
+inline bool IsAudioNoiseEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kAntidetectAudioNoise);
+}
+
+inline uint64_t GetAudioNoiseSeed() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(kAntidetectAudioNoiseSeed)) {
+    uint64_t seed = 0;
+    if (base::StringToUint64(
+            cmd->GetSwitchValueASCII(kAntidetectAudioNoiseSeed), &seed)) {
+      return seed;
+    }
+  }
+  static uint64_t session_seed = base::RandUint64();
+  return session_seed;
+}
+
+// ---- ClientRects noise ----
+
+inline bool IsClientRectsNoiseEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kAntidetectClientRectsNoise);
+}
+
+inline double GetClientRectsNoiseOffset(double input, uint64_t seed) {
+  uint64_t state = seed ^ static_cast<uint64_t>(input * 1000000.0);
+  state ^= state >> 12;
+  state ^= state << 25;
+  state ^= state >> 27;
+  uint64_t rng = state * 0x2545F4914F6CDD1DULL;
+  // Noise in range [-0.001, +0.001] pixels — invisible but changes hash
+  return (static_cast<double>(rng & 0xFFFFF) / 0xFFFFF - 0.5) * 0.002;
+}
+
+inline uint64_t GetClientRectsNoiseSeed() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(kAntidetectClientRectsNoiseSeed)) {
+    uint64_t seed = 0;
+    if (base::StringToUint64(
+            cmd->GetSwitchValueASCII(kAntidetectClientRectsNoiseSeed), &seed))
+      return seed;
+  }
+  static uint64_t session_seed = base::RandUint64();
+  return session_seed;
+}
+
+}  // namespace antidetect
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_ANTIDETECT_ANTIDETECT_UTILS_H_
