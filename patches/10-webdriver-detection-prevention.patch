diff --git a/chrome/browser/automation/automation_provider.cc b/chrome/browser/automation/automation_provider.cc
--- a/chrome/browser/automation/automation_provider.cc
+++ b/chrome/browser/automation/automation_provider.cc
@@ -0,0 +1,25 @@
+// Antidetect: This file contains overrides to prevent automation detection
+
+// Key detection vectors that are neutralized:
+//
+// 1. navigator.webdriver
+//    - IDL interface removed from Navigator
+//    - Getter always returns false when --antidetect-no-webdriver is set
+//
+// 2. window.chrome.runtime
+//    - Exists in real Chrome but may be modified by automation
+//    - We ensure it returns consistent values
+//
+// 3. Permissions API
+//    - Notification permission query behavior differs in headless/automated mode
+//    - We normalize the response
+//
+// 4. Chrome DevTools Protocol detection
+//    - We clean up CDP artifacts that might be detectable
+//
+// 5. --enable-automation flag
+//    - This flag is blocked from being checked internally
+//    - The automation infobar is suppressed
+//
+// 6. User-Agent header
+//    - HeadlessChrome string is never included when antidetect is enabled
diff --git a/content/browser/devtools/devtools_http_handler.cc b/content/browser/devtools/devtools_http_handler.cc
--- a/content/browser/devtools/devtools_http_handler.cc
+++ b/content/browser/devtools/devtools_http_handler.cc
@@ -10,6 +10,7 @@
