 #include "base/logging.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/strings/string_util.h"
@@ -50,6 +51,18 @@ namespace content {

 namespace {

+// Antidetect: Prevent DevTools port detection via /json/version endpoint
+// when running in antidetect mode. Sites can detect automation by trying
+// to connect to common DevTools ports (9222, 9229, etc.)
+bool ShouldHideDevToolsEndpoint() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd->HasSwitch("antidetect-no-webdriver");
+}
+
 }  // namespace

