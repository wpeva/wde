 namespace blink {

 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  // Antidetect: Override hardware concurrency
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(antidetect::kAntidetectHardwareConcurrency)) {
+    unsigned value = 0;
+    if (base::StringToUint(
+            cmd->GetSwitchValueASCII(antidetect::kAntidetectHardwareConcurrency),
+            &value) && value > 0) {
+      return value;
+    }
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }

 }  // namespace blink
