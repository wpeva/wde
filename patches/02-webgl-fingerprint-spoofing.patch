+// Antidetect: Apply WebGL spoofing to GPUInfo
+void GPUInfo::ApplyAntidetectOverrides() {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+
+  if (cmd->HasSwitch("antidetect-webgl-vendor")) {
+    std::string vendor = cmd->GetSwitchValueASCII("antidetect-webgl-vendor");
+    gpu.gl_vendor = vendor;
+    gpu.driver_vendor = vendor;
+  }
+
+  if (cmd->HasSwitch("antidetect-webgl-renderer")) {
+    std::string renderer = cmd->GetSwitchValueASCII("antidetect-webgl-renderer");
+    gpu.gl_renderer = renderer;
+  }
+}
