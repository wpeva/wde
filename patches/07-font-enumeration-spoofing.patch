+// Antidetect: Check if a font family is in the allowed whitelist
+bool FontCache::IsAntidetectFontAllowed(const AtomicString& family_name) {
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch("antidetect-font-list"))
+    return true;  // No filtering if not configured
+
+  static bool initialized = false;
+  static HashSet<String> allowed_fonts;
+
+  if (!initialized) {
+    std::string font_list = cmd->GetSwitchValueASCII("antidetect-font-list");
+    std::vector<std::string> parts = base::SplitString(
+        font_list, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    for (const auto& font : parts) {
+      allowed_fonts.insert(String::FromUTF8(font).LowerASCII());
+    }
+    // Always allow generic font families
+    allowed_fonts.insert("serif");
+    allowed_fonts.insert("sans-serif");
+    allowed_fonts.insert("monospace");
+    allowed_fonts.insert("cursive");
+    allowed_fonts.insert("fantasy");
+    allowed_fonts.insert("system-ui");
+    allowed_fonts.insert("math");
+    allowed_fonts.insert("emoji");
+    allowed_fonts.insert("fangsong");
+    initialized = true;
+  }
+
+  return allowed_fonts.Contains(family_name.LowerASCII());
+}
+
 const SimpleFontData* FontCache::GetFontData(
     const FontDescription& font_description,
     const AtomicString& family_name) {
+  // Antidetect: Block fonts not in the allowed list
+  if (!IsAntidetectFontAllowed(family_name)) {
+    return nullptr;  // Will fall back to default font
+  }
+
   ...
 }

